# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/your_database_name

# Session Configuration (REQUIRED in production)
SESSION_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# Authentication Configuration (REQUIRED in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-node-e-const-bcrypt-require-bcrypt-bcrypt.hash-your-password-10-then-log-the-hash

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_LOGIN_MAX=5

# Security
HELMET_CSP_ENABLED=true
