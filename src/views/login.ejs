<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link href="/style/main.css" rel="stylesheet">
    <style>
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .error-message {
            animation: slideDown 0.3s ease-out;
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-10px); }
            75% { transform: translateX(10px); }
        }
        .shake {
            animation: shake 0.5s ease-in-out;
        }
    </style>
</head>

<body class="flex h-screen bg-indigo ">
    <div class="relative w-full max-w-xs p-5 m-auto bg-white rounded <%= typeof error !== 'undefined' && error ? 'shake' : '' %>">
        <a href="/" class="absolute p-1 transition-colors rounded-full top-5 left-2 hover:bg-gray-200">
            <img class="rotate-90 " src="/assets/arrow-down.svg" alt="Back">
        </a>
        <header>
            <img class="w-20 mx-auto mb-5" src="/assets/logo-unram.png" />
        </header>
        
        <!-- Error Message Display -->
        <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 mb-4 bg-red-100 border-l-4 border-red-500 rounded-r error-message">
            <div class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <p class="text-sm font-semibold text-red-700"><%= error %></p>
            </div>
        </div>
        <% } %>
        
        <!-- Success Message Display (for future use) -->
        <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-3 mb-4 bg-green-100 border-l-4 border-green-500 rounded-r error-message">
            <div class="flex items-center">
                <svg class="w-5 h-5 mr-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <p class="text-sm font-semibold text-green-700"><%= success %></p>
            </div>
        </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm">
            <div>
                <label class="block mb-2 text-indigo" for="username"><%= translate('auth.user') %></label>
                <input class="w-full p-2 mb-6 transition-colors border-b-2 outline-none text-indigo border-indigo focus:bg-gray-300"
                    type="text" name="username" id="username" required>
            </div>
            <div>
                <label class="block mb-2 text-indigo" for="password"><%= translate('auth.password') %></label>
                <input class="w-full p-2 mb-6 transition-colors border-b-2 outline-none text-indigo border-indigo focus:bg-gray-300"
                    type="password" name="password" id="password" required>
            </div>
            <div>
                <input
                    class="w-full px-4 py-2 mb-6 font-bold text-white transition-colors rounded bg-indigo hover:bg-veronica hover:cursor-pointer"
                    type="submit" value="<%= translate('auth.login') %>">
            </div>
        </form>
        <footer class="">
            <a class="float-right text-sm text-indigo hover:text-veronica"
                href="#"><%= translate('auth.forgotPassword') %></a>
        </footer>
    </div>
</body>