<!DOCTYPE html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Memuat Tailwind CSS dari CDN untuk kemudahan -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
    <link href="/style/main.css" rel="stylesheet">
</head>

<body>
    <%- include('partials/navbar', {isLogin}) %>
    <div class="flex items-center justify-center min-h-screen bg-gray-100 py-12 px-4">
        <div class="text-center max-w-2xl">
            <!-- Error Code -->
            <h1 class="font-bold text-9xl text-veronica">
                <%= title.match(/\d+/)?.[0] || '404' %>
            </h1>

            <!-- Error Message -->
            <p class="mt-4 text-2xl font-light text-gray-800 md:text-3xl">
                <%= typeof message !== 'undefined' ? message : 'Oops! Halaman Tidak Ditemukan.' %>
            </p>

            <!-- URL Info (only for 404) -->
            <% if (typeof url !== 'undefined' && url) { %>
            <p class="mt-4 text-gray-500">
                Halaman yang Anda cari untuk URL <code class="p-1 bg-gray-200 rounded text-sm"><%= url %></code> tidak
                ada.
            </p>
            <% } %>

            <!-- Development Error Details -->
            <% if (typeof error !== 'undefined' && error && process.env.NODE_ENV === 'development') { %>
            <div class="mt-6 p-4 bg-red-50 border border-red-200 rounded-lg text-left">
                <h3 class="text-lg font-semibold text-red-800 mb-2">🐛 Development Error Details:</h3>
                <p class="text-sm text-red-700 mb-2"><strong>Status:</strong> <%= error.status || 'error' %></p>
                <p class="text-sm text-red-700 mb-2"><strong>Message:</strong> <%= error.message %></p>
                <% if (typeof stack !== 'undefined' && stack) { %>
                <details class="mt-3">
                    <summary class="cursor-pointer text-sm font-semibold text-red-800 hover:text-red-900">Stack Trace
                    </summary>
                    <pre class="mt-2 p-3 bg-red-100 rounded text-xs overflow-auto max-h-64"><%= stack %></pre>
                </details>
                <% } %>
            </div>
            <% } %>

            <!-- Action Buttons -->
            <div class="mt-8 flex flex-wrap gap-4 justify-center">
                <a href="javascript:history.back()"
                    class="inline-block px-6 py-3 text-lg font-semibold text-gray-700 transition-colors rounded-lg shadow-md bg-gray-200 hover:bg-gray-300">
                    ← Kembali
                </a>
                <a href="/"
                    class="inline-block px-6 py-3 text-lg font-semibold text-white transition-colors rounded-lg shadow-md bg-veronica hover:bg-indigo">
                    🏠 Halaman Utama
                </a>
            </div>

            <!-- Help Text -->
            <p class="mt-8 text-sm text-gray-500">
                Jika masalah terus berlanjut, silakan hubungi administrator sistem.
            </p>
        </div>
    </div>
    <%- include('partials/footer') %>
</body>