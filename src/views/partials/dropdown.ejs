<!-- Dropdown menggunakan partial -->
<div id="prodiDropdownDesktop"
    class="absolute hidden mt-8 -translate-x-1/2 bg-white shadow-[0px_10px_20px_5px] shadow-black/25 group-hover:block w-52 left-1/2 rounded-2xl">
    <div class="px-4 py-2 text-center text-gray-500">Memuat...</div>
</div>

<script src="/libs/axios/dist/axios.min.js"></script>
<script>
    // Fetch prodi options and populate dropdowns
    async function fetchProdiOptions() {
        try {
            const response = await axios.get('/api/prodi-options');

            if (response.data.success && response.data.data) {
                populateProdiDropdowns(response.data.data);
            } else {
                showProdiError();
            }
        } catch (error) {
            console.error('Error fetching prodi options:', error);
            showProdiError();
        }
    }

    // Populate both desktop and mobile prodi dropdowns
    function populateProdiDropdowns(prodiOptions) {
        populateDesktopDropdown(prodiOptions);
    }

    // Populate desktop dropdown
    function populateDesktopDropdown(prodiOptions) {
        const dropdown = document.getElementById('prodiDropdownDesktop');
        if (!dropdown) return;

        dropdown.innerHTML = '';

        if (prodiOptions && prodiOptions.length > 0) {
            prodiOptions.forEach((prodi, index) => {
                const prodiSlug = prodi.toLowerCase()
                    .replace(/\s+/g, '-')
                    .replace(/[^a-z0-9\-]/g, '');

                const link = document.createElement('a');
                link.href = `/prodi/${prodiSlug}`;

                // Styling sesuai dengan dropdown partial
                let className = 'block px-4 py-2 font-semibold text-center hover:bg-veronica hover:text-white';

                // Tambahkan styling khusus untuk item pertama
                if (index === 0) {
                    className += ' rounded-t-2xl relative before:content-[\'\'] before:hover:bg-veronica before:absolute before:-top-[10px] before:left-1/2 before:-translate-x-1/2 before:h-5 before:w-5 before:bg-white before:rotate-45 before:-z-[1]';
                }

                // Tambahkan styling khusus untuk item terakhir
                if (index === prodiOptions.length - 1) {
                    className += ' rounded-b-2xl';
                }

                link.className = className;
                link.textContent = prodi;

                dropdown.appendChild(link);
            });
        } else {
            const noData = document.createElement('div');
            noData.className = 'px-4 py-2 text-sm text-center text-gray-500';
            noData.textContent = 'Belum ada data program studi';
            dropdown.appendChild(noData);
        }
    }

    // Show error message in dropdowns
    function showProdiError() {
        const desktopDropdown = document.getElementById('prodiDropdownDesktop');
        const mobileDropdown = document.getElementById('prodiDropdownMobile');

        const errorMessage = 'Gagal memuat data';

        if (desktopDropdown) {
            desktopDropdown.innerHTML = `<div class="px-4 py-2 text-sm text-center text-red-500">${errorMessage}</div>`;
        }

        if (mobileDropdown) {
            mobileDropdown.innerHTML = `<div class="px-4 py-2 text-sm text-red-500">${errorMessage}</div>`;
        }
    }

    // Add hover functionality for desktop dropdown (handled by CSS group-hover, so this is simplified)
    function initializeDesktopDropdown() {
        // Desktop dropdown menggunakan CSS group-hover, jadi tidak perlu event listeners manual
        // Hanya pastikan dropdown sudah ada di DOM
        const dropdown = document.getElementById('prodiDropdownDesktop');
    }

    // Initialize when DOM is loaded
    document.addEventListener('DOMContentLoaded', function () {
        fetchProdiOptions();
        initializeDesktopDropdown();
    });

</script>
