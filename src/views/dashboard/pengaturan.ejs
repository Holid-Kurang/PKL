<!DOCTYPE html>
<html>

    <%- include('../partials/head', {title}) %>

    <body class="bg-gray-50">
        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar -->
            <%- include('../partials/sidebar-dashboard') %>

            <!-- Main Content -->
            <div class="flex flex-col flex-1 overflow-hidden">
                <!-- Header -->
                <header class="bg-white shadow-sm">
                    <div class="flex items-center justify-between h-20 px-8">
                        <div class="flex items-center gap-3">
                            <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo/10">
                                <span class="text-xl material-icons-outlined text-indigo">settings</span>
                            </div>
                            <div>
                                <h1 class="text-2xl font-bold text-gray-800"><%= translate('navbar.pengaturan') %></h1>
                                <p class="text-sm text-gray-500">Kelola kategori dan opsi dropdown</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-4">
                            <%- include('../partials/dropdown') %>
                        </div>
                    </div>
                </header>

                <!-- Dashboard Content -->
                <main class="flex-1 p-8 overflow-y-auto">
                    <!-- Action Bar -->
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-gray-800">Daftar Kategori</h2>
                    </div>

                    <!-- Categories Grid -->
                    <div id="kategori-container" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                        <!-- Loading state -->
                        <div class="col-span-full">
                            <div class="flex items-center justify-center py-12">
                                <span class="text-5xl material-icons-outlined animate-spin text-indigo"> 
                                    hourglass_empty
                                </span>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- Add Option Modal -->
        <div id="modal-add-option" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-900/50">
                            <span class="text-lg material-icons-outlined text-indigo-700">add_circle_outline</span>
                        </div>
                        <h2 class="text-xl font-bold text-gray-800">Tambah Opsi</h2>
                    </div>
                    <span class="close" id="close-add-option">&times;</span>
                </div>
                <form id="form-add-option">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" id="add-option-kategori-id">
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Kategori</label>
                        <input type="text" id="add-option-kategori-name" readonly
                            class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-lg text-gray-500">
                    </div>
                    <div class="mb-6">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Opsi Baru</label>
                        <input type="text" id="new-option" name="option" required
                            class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-700/30 focus:border-indigo-700 transition-all"
                            placeholder="Masukkan opsi baru">
                    </div>
                    <div class="flex justify-end gap-3">
                        <button type="button"
                            class="px-5 py-2.5 text-sm font-medium text-gray-700 transition-colors bg-gray-100 rounded-lg hover:bg-gray-200"
                            id="btn-cancel-add-option">
                            Batal
                        </button>
                        <button type="submit"
                            class="px-5 py-2.5 text-sm font-medium text-white transition-all rounded-lg bg-indigo hover:bg-indigo/80 shadow-sm hover:shadow">
                            Tambah Opsi
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div id="modal-delete" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-3">
                        <div class="flex items-center justify-center w-9 h-9 rounded-lg bg-red-900/30">
                            <span class="text-lg material-icons-outlined text-red-700">warning_amber</span>
                        </div>
                        <h2 class="text-xl font-bold text-gray-800">Konfirmasi Hapus</h2>
                    </div>
                    <span class="close" id="close-delete">&times;</span>
                </div>
                <p class="mb-6 text-gray-600 pl-12" id="delete-message">Apakah Anda yakin ingin menghapus item ini?</p>
                <div class="flex justify-end gap-3">
                    <button type="button"
                        class="px-5 py-2.5 text-sm font-medium text-gray-700 transition-colors bg-gray-100 rounded-lg hover:bg-gray-200"
                        id="btn-cancel-delete">
                        Batal
                    </button>
                    <button type="button"
                        class="px-5 py-2.5 text-sm font-medium text-white transition-all bg-red-500 rounded-lg hover:bg-red-600 shadow-sm hover:shadow"
                        id="btn-confirm-delete">
                        Hapus
                    </button>
                </div>
            </div>
        </div>

        <script src="/script/pengaturan.js"></script>
    </body>

</html>