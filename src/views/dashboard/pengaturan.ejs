<!DOCTYPE html>
<html>

    <%- include('../partials/head', {title}) %>

    <body class="bg-gray-50">
        <div class="flex h-screen overflow-hidden">
            <!-- Sidebar -->
            <%- include('../partials/sidebar-dashboard') %>

            <!-- Main Content -->
            <div class="flex flex-col flex-1 overflow-hidden">
                <!-- Header -->
                <header class="bg-white shadow-sm">
                    <div class="flex items-center justify-between h-20 px-8">
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800"><%= translate('navbar.pengaturan') %></h1>
                            <p class="text-sm text-gray-600">Kelola kategori dan opsi dropdown</p>
                        </div>
                        <div class="flex items-center gap-4">
                            <%- include('../partials/dropdown') %>
                        </div>
                    </div>
                </header>

                <!-- Dashboard Content -->
                <main class="flex-1 p-8 overflow-y-auto">
                    <!-- Action Bar -->
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-semibold text-gray-800">Daftar Kategori</h2>
                        <button id="btn-add-kategori"
                            class="flex items-center gap-2 px-4 py-2 text-white transition-colors rounded bg-indigo hover:bg-indigo/80">
                            <span class="material-icons-outlined">add</span>
                            Tambah Kategori
                        </button>
                    </div>

                    <!-- Categories Grid -->
                    <div id="kategori-container" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                        <!-- Loading state -->
                        <div class="col-span-full">
                            <div class="flex items-center justify-center py-12">
                                <span class="text-5xl material-icons-outlined animate-spin text-indigo"> 
                                    hourglass_empty
                                </span>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- Add Kategori Modal -->
        <div id="modal-add-kategori" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Tambah Kategori Baru</h2>
                    <span class="close" id="close-add-kategori">&times;</span>
                </div>
                <form id="form-add-kategori">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Nama Kategori</label>
                        <input type="text" id="kategori-name" name="kategori" required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo"
                            placeholder="Contoh: Jenis Penelitian">
                    </div>
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Opsi Pertama (Opsional)</label>
                        <input type="text" id="first-option" name="firstOption"
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo"
                            placeholder="Contoh: Penelitian Dasar">
                        <p class="mt-1 text-xs text-gray-500">Anda dapat menambahkan opsi lain setelah kategori dibuat
                        </p>
                    </div>
                    <div class="flex justify-end gap-2">
                        <button type="button"
                            class="px-4 py-2 text-gray-700 transition-colors bg-gray-200 rounded hover:bg-gray-300"
                            id="btn-cancel-add-kategori">
                            Batal
                        </button>
                        <button type="submit"
                            class="px-4 py-2 text-white transition-colors rounded bg-indigo hover:bg-indigo/80">
                            Simpan
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Edit Kategori Modal -->
        <div id="modal-edit-kategori" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Edit Kategori</h2>
                    <span class="close" id="close-edit-kategori">&times;</span>
                </div>
                <form id="form-edit-kategori">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" id="edit-kategori-id">
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Nama Kategori</label>
                        <input type="text" id="edit-kategori-name" name="kategori" required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo">
                    </div>
                    <div class="flex justify-end gap-2">
                        <button type="button"
                            class="px-4 py-2 text-gray-700 transition-colors bg-gray-200 rounded hover:bg-gray-300"
                            id="btn-cancel-edit-kategori">
                            Batal
                        </button>
                        <button type="submit"
                            class="px-4 py-2 text-white transition-colors rounded bg-indigo hover:bg-indigo/80">
                            Update
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add Option Modal -->
        <div id="modal-add-option" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Tambah Opsi</h2>
                    <span class="close" id="close-add-option">&times;</span>
                </div>
                <form id="form-add-option">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" id="add-option-kategori-id">
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Kategori</label>
                        <input type="text" id="add-option-kategori-name" readonly
                            class="w-full px-3 py-2 bg-gray-100 border border-gray-300 rounded">
                    </div>
                    <div class="mb-4">
                        <label class="block mb-2 text-sm font-medium text-gray-700">Opsi Baru</label>
                        <input type="text" id="new-option" name="option" required
                            class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-indigo"
                            placeholder="Masukkan opsi baru">
                    </div>
                    <div class="flex justify-end gap-2">
                        <button type="button"
                            class="px-4 py-2 text-gray-700 transition-colors bg-gray-200 rounded hover:bg-gray-300"
                            id="btn-cancel-add-option">
                            Batal
                        </button>
                        <button type="submit"
                            class="px-4 py-2 text-white transition-colors rounded bg-indigo hover:bg-indigo/80">
                            Tambah
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Delete Confirmation Modal -->
        <div id="modal-delete" class="modal">
            <div class="modal-content">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-xl font-bold text-gray-800">Konfirmasi Hapus</h2>
                    <span class="close" id="close-delete">&times;</span>
                </div>
                <p class="mb-6 text-gray-600" id="delete-message">Apakah Anda yakin ingin menghapus item ini?</p>
                <div class="flex justify-end gap-2">
                    <button type="button"
                        class="px-4 py-2 text-gray-700 transition-colors bg-gray-200 rounded hover:bg-gray-300"
                        id="btn-cancel-delete">
                        Batal
                    </button>
                    <button type="button"
                        class="px-4 py-2 text-white transition-colors bg-red-600 rounded hover:bg-red-700"
                        id="btn-confirm-delete">
                        Hapus
                    </button>
                </div>
            </div>
        </div>

        <script src="/script/pengaturan.js"></script>
    </body>

</html>