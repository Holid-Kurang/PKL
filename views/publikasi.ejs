<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="/style/main.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="favicon.png">
    <style>
    </style>
</head>

<body class="text-center bg-[#EDF0F1] ">
    <%- include('partials/navbar', {isLogin, prodiOptions}) %>
        <!-- Dropdown untuk memilih jenis penelitian -->
        <div class="py-6 ">
            <div class="text-center">
                <label for="jenispenelitian" class="block mb-4 text-2xl font-bold text-indigo">Pilih Publikasi</label>
                <select id="jenispenelitian" class="px-6 py-3 text-lg font-medium transition-all duration-200 bg-white border-2 border-indigo-300 rounded-lg penelitian-select text-indigo focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200">
                    <option value="buku">Buku</option>
                    <option value="haki">HAKI</option>
                    <option value="jupeng">Jurnal Pengabdian</option>
                </select>
            </div>
        </div>
        
        <!-- Container untuk grafik yang akan berubah -->
        <div id="chart-container">
            <!-- Grafik Buku -->
            <div id="buku-section" class="chart-section">
                <h1 class="text-4xl font-bold text-center  text-indigo">Buku</h1>
                <div class="grid grid-cols-2 grid-rows-1 gap-8 px-32 py-2 h-[70vh]">
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="bukuPerTahun" class="block w-full h-full"></canvas>
                    </div>
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="bukuPerProdi" class="block w-full h-full"></canvas>
                    </div>
                </div>
            </div>

            <!-- Grafik HAKI -->
            <div id="haki-section" class="chart-section" style="display: none;">
                <h1 class="text-4xl font-bold text-center  text-indigo">HAKI</h1>
                <div class="grid grid-cols-2 grid-rows-2 gap-8 px-32 py-2 h-[100vh]">
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="hakiPerJenis" class="block w-full h-full"></canvas>
                    </div>
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="hakiPerProdi" class="block w-full h-full"></canvas>
                    </div>
                    <div class="col-span-2 row-start-2 bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="hakiPerTahun" class="block w-full h-full"></canvas>
                    </div>
                </div>
            </div>

            <!-- Grafik Jurnal Pengabdian -->
            <div id="jupeng-section" class="chart-section" style="display: none;">
                <h1 class="text-4xl font-bold text-center  text-indigo">Jurnal Pengabdian</h1>
                <div class="grid grid-cols-2 grid-rows-1 gap-8 px-32 py-2 h-[70vh]">
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="jupengPerTahun" class="block w-full h-full"></canvas>
                    </div>
                    <div class="bg-white shadow-xl rounded-xl shadow-gray-800/25">
                        <canvas id="jupengPerProdi" class="block w-full h-full"></canvas>
                    </div>
                </div>
            </div>
        </div>
    <%- include('partials/footer') %>
    
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            window.jupengData = {
                jumlahPerTahun: <%- JSON.stringify(jupengData.jumlahPerTahun) %>,
                jumlahPerProdi: <%- JSON.stringify(jupengData.jumlahPerProdi) %>
            };
            
            window.hakiData = {
                jumlahPerTahun: <%- JSON.stringify(hakiData.jumlahPerTahun) %>,
                jumlahPerJenis: <%- JSON.stringify(hakiData.jumlahPerJenis) %>,
                jumlahPerProdi: <%- JSON.stringify(hakiData.jumlahPerProdi) %>
            };

            window.bukuData = {
                jumlahPerTahun: <%- JSON.stringify(bukuData.jumlahPerTahun) %>,
                jumlahPerProdi: <%- JSON.stringify(bukuData.jumlahPerProdi) %>
            };
        </script>
        <script src="/script/publikasi.js"></script>
</body>

</html>