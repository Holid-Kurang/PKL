<!DOCTYPE html>
<html lang="<%= currentLang %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="/style/main.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="favicon.png">
    <script>
        // Set translations globally for JavaScript
        window.pageTranslations = <%- pageTranslations %>;
    </script>
</head>

<body class="bg-[#EDF0F1] text-[#232F58]">
    <%- include('partials/navbar', {isLogin}) %>
        <div class="my-5 mx-14 md:my-10 md:mx-28">
            <h1 class="font-bold text-[30px] md:text-[40px]"><%= __('welcome.title') %></h1>
            <div class="flex flex-col gap-6 md:flex-row">
                <p class="text-[20px] md:text-[25px] text-justify md:text-left"><%= __('welcome.description') %></p>
                <img class="rounded-[30px] w-full md:w-[500px] self-center" src="/assets/gedung-teknik.png" alt="">
            </div>
            <h1 class="font-bold text-[25px] md:text-[35px] text-center my-5"><%= __('welcome.summaryTitle') %></h1>
            
            <!-- Loading State -->
            <div id="loadingState" class="flex items-center justify-center py-20">
                <div class="w-12 h-12 border-b-2 rounded-full animate-spin border-veronica"></div>
                <span class="ml-3 text-lg"><%= __('dashboard.loading') %></span>
            </div>
            
            <!-- Main Content (hidden by default) -->
            <div id="mainContent" class="hidden">
                <div class="flex flex-col justify-center gap-6 md:flex-row md:gap-36">
                    <div
                        class="w-[30%] flex flex-col shadow-xl bg-white shadow-gray-800/25  rounded-[30px] h-[30%] aspect-square p-5 animate-on-scroll slide-left-fade-in">
                        <canvas id="penelitianChart" class="w-full h-full "></canvas>
                    </div>
                    <p id="penelitianText"
                        class="w-full md:w-[30%]  text-[16px] md:text-[20px] text-justify md:text-left aspect-square content-center animate-on-scroll slide-right-fade-in">
                        <!-- Content will be populated by JavaScript -->
                    </p>
                </div>
                <div class="flex flex-col-reverse justify-center gap-6 md:flex-row md:gap-36">
                    <p id="pengabdianText" class="w-[30%] md:text-[20px]  aspect-square content-center animate-on-scroll slide-left-fade-in">
                        <!-- Content will be populated by JavaScript -->
                    </p>
                    <div
                        class="w-[30%] flex flex-col bg-white shadow-xl shadow-gray-800/25 rounded-[30px] h-[30%] aspect-square p-5 animate-on-scroll slide-right-fade-in">
                        <canvas id="pengabdianChart" class="w-full h-full "></canvas>
                    </div>
                </div>
                <div class="flex flex-col justify-center gap-6 md:flex-row md:gap-36">
                    <div
                        class="w-[30%] flex flex-col shadow-xl bg-white shadow-gray-800/25 rounded-[30px] h-[30%] aspect-square p-5 animate-on-scroll slide-left-fade-in">
                        <canvas id="publikasiChart" class="w-full h-full "></canvas>
                    </div>
                    <p id="publikasiText" class="w-[30%]  md:text-[20px]  aspect-square content-center animate-on-scroll slide-right-fade-in">
                        <!-- Content will be populated by JavaScript -->
                    </p>
                </div>
            </div>
        </div>
        <div class="py-8">
            <div class="mx-14 md:mx-28">
                <h2 class="font-bold text-[25px] md:text-[35px] text-center mb-8"><%= __('dashboard.table.title') %></h2>
                
                <!-- Loading State for Table -->
                <div id="tableLoadingState" class="flex items-center justify-center py-20">
                    <div class="w-8 h-8 border-b-2 rounded-full animate-spin border-veronica"></div>
                    <span class="ml-3">Memuat data tabel...</span>
                </div>
                
                <!-- Table Content -->
                <div id="tableContent" class="hidden overflow-x-auto">
                    <table class="w-full text-sm border border-collapse border-gray-300">
                        <thead class="text-white">
                            <tr class="bg-veronica">
                                <th rowspan="2" class="px-4 py-3 font-semibold text-center border border-gray-300"><%= __('dashboard.table.programStudi') %></th>
                                <th colspan="3" class="px-4 py-2 font-semibold text-center border border-gray-300"><%= __('navbar.penelitian') %></th>
                                <th colspan="2" class="px-4 py-2 font-semibold text-center border border-gray-300"><%= __('navbar.pengabdian') %></th>
                                <th colspan="3" class="px-4 py-2 font-semibold text-center border border-gray-300"><%= __('navbar.publikasi') %></th>
                            </tr>
                            <tr class="bg-veronica">
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.pusat') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.pnbp') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.mandiri') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.pnbp') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.pusat') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.haki') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.buku') %></th>
                                <th class="px-3 py-2 text-xs font-medium text-center border border-gray-300"><%= __('categories.jupeng') %></th>
                            </tr>
                        </thead>
                        <tbody id="prodiTableBody">
                            <!-- Content will be populated by JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <%- include('partials/footer') %>
    
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/script/index.js"></script>
</body>

</html>