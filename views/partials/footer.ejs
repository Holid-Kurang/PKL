<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Outlined" rel="stylesheet">
    
</head>
<!-- ======================= FOOTER SECTION ======================= -->

<footer class="text-white bg-indigo">
    <div class="container px-6 py-10 mx-auto">

        <div class="grid grid-cols-1 gap-8 text-center md:grid-cols-3 md:text-left">

            <!-- Kolom 1: Logo dan Deskripsi -->
            <div class="md:col-span-1">
                <div class="flex items-center justify-center md:justify-start">
                    <img src="/assets/logo-unram.png" alt="Logo Universitas Mataram"
                        class="w-16 h-16 mr-4">
                    <div>
                        <h2 class="text-xl font-bold"><%= __('footer.title') %></h2>
                        <p class="text-sm text-white"><%= __('footer.subtitle') %></p>
                    </div>
                </div>
                <p class="max-w-sm mx-auto mt-4 text-sm text-white md:mx-0">
                    <%= __('footer.description') %>
                </p>
            </div>

            <!-- Kolom 2: Tautan Navigasi (Opsional) -->
            <div class="md:col-span-1">
                <h3 class="text-lg font-semibold tracking-wide uppercase"><%= __('footer.quickLinks') %></h3>
                <ul class="mt-4 space-y-2">
                    <li>
                        <a href="/" class="text-white transition-colors hover:text-white"><%= __('footer.home') %></a>
                    </li>
                    <li>
                        <a href="/penelitian" class="text-white transition-colors hover:text-white"><%= __('navbar.penelitian') %></a>
                    </li>
                    <li>
                        <a href="/pengabdian" class="text-white transition-colors hover:text-white"><%= __('navbar.pengabdian') %></a>
                    </li>
                    <li>
                        <a href="/publikasi" class="text-white transition-colors hover:text-white"><%= __('navbar.publikasi') %></a>
                    </li>
                </ul>
            </div>

            <!-- Kolom 3: Informasi Kontak -->
            <div class="md:col-span-1">
                <h3 class="text-lg font-semibold tracking-wide uppercase"><%= __('footer.contact') %></h3>
                <div class="mt-4 space-y-4">
                    <div class="flex items-center justify-center md:justify-start">
                        <span class="mr-3 text-white material-icons-outlined">email</span>
                        <div>
                            <p class="font-semibold"><%= __('footer.email') %></p>
                            <a href="mailto:xxxxxxx@gmail.com"
                                class="text-sm text-white hover:text-white">xxxxxxx@gmail.com</a>
                        </div>
                    </div>
                    <div class="flex items-center justify-center md:justify-start">
                        <span class="mr-3 text-white material-icons-outlined">phone</span>
                        <div>
                            <p class="font-semibold"><%= __('footer.phone') %></p>
                            <p class="text-sm text-white">XXXX-XXXX-XXXX</p>
                        </div>
                    </div>
                    <div class="flex items-center justify-center md:justify-start">
                        <span class="mr-3 text-white material-icons-outlined">location_on</span>
                        <div>
                            <p class="font-semibold"><%= __('footer.address') %></p>
                            <p class="text-sm text-white"><%= __('footer.addressText') %></p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Garis pemisah dan Copyright -->
        <div class="pt-6 mt-10 text-sm text-center text-white border-t border-indigo-500">
            <p>&copy; 2025 <%= __('footer.copyright') %></p>
        </div>

    </div>
</footer>