<div id="modal">
</div>

<script>
    // Get prodi options from server
    const prodiOptionsFromServer = <%- prodiOptions %>;
    const hakiOptions = <%- hakiOptions %>;
    // Define modal configurations for each category
    const modalConfigs = {
        'penelitian-pnbp': {
            action: '/api/dashboard/penelitian-pnbp/create',
            formFields: [
                { name: 'Judul', label: 'Judul', type: 'text', required: true },
                { name: 'SKEMA', label: 'Skema', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer},
                { name: 'Ketua', label: 'Ketua', type: 'text', required: true },
                { name: 'Anggota', label: 'Anggota', type: 'anggota', required: false },
                { name: 'Biaya', label: 'Dana', type: 'number', required: true },
                { name: 'Tahun', label: 'Tahun', type: 'number', required: true },
                { name: 'Nilai', label: 'Nilai', type: 'text', required: true }
            ]
        },
        'penelitian-pusat': {
            action: '/api/dashboard/penelitian-pusat/create',
            formFields: [
                { name: 'Judul', label: 'Judul', type: 'text', required: true },
                { name: 'SKEMA', label: 'Skema', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer },
                { name: 'NAMA', label: 'Ketua', type: 'text', required: true },
                { name: 'Anggota', label: 'Anggota', type: 'anggota', required: false },
                { name: 'NIP', label: 'NIP', type: 'text', required: false },
                { name: 'NIDN', label: 'NIDN', type: 'text', required: false },
                { name: 'BIAYA', label: 'Dana', type: 'number', required: true },
                { name: 'TAHUN', label: 'Tahun', type: 'number', required: true }
            ]
        },
        'penelitian-mandiri': {
            action: '/api/dashboard/penelitian-mandiri/create',
            formFields: [
                { name: 'tahun', label: 'Tahun', type: 'number', required: true }, // ganti nama field dari 'tahun' menjadi 'Tahun' agar konsisten jika perlu
                { name: 'Ketua', label: 'Ketua', type: 'text', required: true },
                { name: 'Skema', label: 'Skema', type: 'text', required: true },
                { name: 'Judul', label: 'Judul', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer },
                { name: 'Dana', label: 'Dana', type: 'number', required: true },
                { name: 'Anggota', label: 'Anggota', type: 'anggota', required: false },
            ]
        },
        'pengabdian-pnbp': {
            action: '/api/dashboard/pengabdian-pnbp/create',
            formFields: [
                { name: 'Judul', label: 'Judul', type: 'text', required: true },
                { name: 'SKEMA', label: 'Skema', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer},
                { name: 'Ketua', label: 'Ketua', type: 'text', required: true },
                { name: 'Anggota', label: 'Anggota', type: 'anggota', required: false },
                { name: 'Dana', label: 'Biaya Disetujui', type: 'number', required: false },
                { name: 'Nilai', label: 'Nilai Rata-rata', type: 'text', required: false },
                { name: 'Tahun', label: 'Tahun', type: 'number', required: true }
            ]
        },
        'pengabdian-pusat': {
            action: '/api/dashboard/pengabdian-pusat/create',
            formFields: [
                { name: 'Judul', label: 'Judul', type: 'text', required: true },
                { name: 'SKEMA', label: 'Skema', type: 'text', required: true },
                { name: 'Nama', label: 'Nama Ketua', type: 'text', required: true },
                { name: 'Anggota', label: 'Anggota', type: 'anggota', required: false },
                { name: 'Dana', label: 'Dana', type: 'number', required: true },
                { name: 'Tahun', label: 'Tahun', type: 'number', required: true },
                { name: 'NomorKontrakLPPM', label: 'Nomor Kontrak LPPM', type: 'text', required: false },
                { name: 'NIP', label: 'NIP', type: 'text', required: false },
                { name: 'JumlahAnggota', label: 'Jumlah Anggota', type: 'number', required: false },
                { name: 'JumlahMshTerlibat', label: 'Jumlah Mhs Terlibat', type: 'number', required: false }
            ]
        },
        'publikasi-buku': {
            action: '/api/dashboard/publikasi-buku/create',
                formFields: [
                { name: 'Judul', label: 'Judul Buku', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer},
                { name: 'buku_isbn', label: 'ISBN', type: 'text', required: true },
                { name: 'buku_jumlah_halaman', label: 'Jumlah Halaman', type: 'number', required: true },
                { name: 'buku_penerbit', label: 'Penerbit', type: 'text', required: true },
                { name: 'buku_file', label: 'File', type: 'text', required: false },
                { name: 'buku_tahun', label: 'Tahun', type: 'number', required: true },
                { name: 'pengguna_kode', label: 'Kode Pengguna', type: 'text', required: true },
                { name: '_pengguna_jenis', label: 'Jenis Pengguna', type: 'text', required: true },
                { name: '_pengguna_nama', label: 'Nama Pengguna', type: 'text', required: true },
            ]
        },
        'publikasi-haki': {
            action: '/api/dashboard/publikasi-haki/create',
            formFields: [
                { name: 'Judul', label: 'Judul HKI', type: 'text', required: true },
                { name: 'hki_jenis', label: 'Jenis HKI', type: 'select', required: true, options: hakiOptions },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer},
                { name: 'hki_file', label: 'File', type: 'text', required: false },
                { name: 'hki_bulan', label: 'Bulan', type: 'text', required: true },
                { name: 'hki_tahun', label: 'Tahun', type: 'number', required: true },
                { name: 'pengguna_kode', label: 'Kode Pengguna', type: 'text', required: true },
                { name: '_pengguna_nama', label: 'Nama Pengguna', type: 'text', required: true },
            ]
        },
        'publikasi-jupeng': {
            action: '/api/dashboard/publikasi-jupeng/create',
            formFields: [
                { name: 'Judul', label: 'Judul Jurnal', type: 'text', required: true },
                { name: 'Prodi', label: 'Prodi', type: 'select', required: true, options: prodiOptionsFromServer},
                { name: 'jurnal_url', label: 'URL Jurnal', type: 'text', required: false },
                { name: 'jurnal_file', label: 'File Jurnal', type: 'text', required: false },
                { name: 'jurnal_tahun', label: 'Tahun', type: 'number', required: true },
                { name: 'jurnal_bulan', label: 'Bulan', type: 'text', required: false },
                { name: 'pengguna_kode', label: 'Kode Pengguna', type: 'text', required: false },
                { name: '_pengguna_jenis', label: 'Jenis Pengguna', type: 'text', required: false },
                { name: '_pengguna_nama', label: 'Nama Pengguna', type: 'text', required: false },
                { name: '_personil_data_ketua', label: 'Ketua Personil', type: 'text', required: false },
                { name: '_personil_data_ketua_kode', label: 'Kode Ketua Personil', type: 'text', required: false },
                { name: '_personil_data_ketua_jenis', label: 'Jenis Ketua Personil', type: 'text', required: false }
            ]
        }
    };

    // Function to generate modal HTML
    function generateModalHTML(config) {
        let formFieldsHTML = '';

        config.formFields.forEach(field => {
            formFieldsHTML += `<div>`;
            formFieldsHTML +=
                `<label for="${field.name}" class="block text-sm font-medium text-left text-gray-700">`;
            formFieldsHTML += field.label;
            if (field.required) {
                formFieldsHTML += `<span class="text-red-500">*</span>`;
            }
            formFieldsHTML += `</label>`;

            if (field.type === 'select') {
                formFieldsHTML +=
                    `<select name="${field.name}" id="${field.name}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-[#4F46E5] focus:border-[#4F46E5]" ${field.required ? 'required' : ''}>`;
                formFieldsHTML += `<option value="" selected disabled>Pilih ${field.label}</option>`;
                field.options.forEach(option => {
                    formFieldsHTML += `<option value="${option}">${option}</option>`;
                });
                formFieldsHTML += `</select>`;
            } else if (field.type === 'anggota') {
                formFieldsHTML += `
                    <div id="anggotaContainer">
                        <div class="flex items-center mb-2 space-x-2 anggota-input-group">
                            <input type="text" name="Anggota[]" placeholder="Nama Anggota" class="flex-1 border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-[#4F46E5] focus:border-[#4F46E5]">
                            <button type="button" onclick="removeAnggotaInput(this)" class="px-3 py-2 text-red-600 border border-red-300 rounded-md hover:bg-red-50 focus:outline-none" style="display: none;">
                                <span class="text-sm material-icons-outlined">remove</span>
                            </button>
                        </div>
                    </div>
                    <button type="button" onclick="addAnggotaInput()" class="mt-2 flex items-center px-3 py-2 text-sm text-[#4F46E5] border border-[#4F46E5] rounded-md hover:bg-[#4F46E5] hover:text-white transition-colors">
                        <span class="mr-1 text-sm material-icons-outlined">add</span>
                        Tambah Anggota
                    </button>
                `;
            } else {
                formFieldsHTML +=
                    `<input type="${field.type}" name="${field.name}" id="${field.name}" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-[#4F46E5] focus:border-[#4F46E5]" ${field.required ? 'required' : ''}>`;
            }

            formFieldsHTML +=
                `<p class="hidden mt-1 text-xs text-red-500" id="error-${field.name}">${field.label} wajib diisi.</p>`;
            if (field.type === 'number') {
                formFieldsHTML +=
                    `<p class="hidden mt-1 text-xs text-red-500" id="type-error-${field.name}">${field.label} harus berupa angka.</p>`;
            }
            formFieldsHTML += `</div>`;
        });

        return `
            <div id="addDataModal" class="fixed inset-0 z-50 flex items-center justify-center hidden bg-black bg-opacity-50">
                <div class="w-full max-w-2xl transition-all transform bg-white rounded-lg shadow-xl">
                    <div class="flex items-center justify-between px-6 py-4 border-b">
                        <h3 class="text-xl font-semibold text-gray-800">Tambah Data</h3>
                        <button onclick="closeModal('addDataModal')" class="text-gray-500 hover:text-gray-800">
                            <span class="material-icons-outlined">close</span>
                        </button>
                    </div>
                    <div class="p-6 max-h-[60vh] overflow-y-auto">
                        <form id="addDataForm" action="${config.action}" method="POST" class="space-y-4">
                            ${formFieldsHTML}
                        </form>
                    </div>
                    <div class="px-6 py-4 space-x-3 text-right bg-gray-50">
                        <button onclick="closeModal('addDataModal')" type="button" class="px-4 py-2 text-sm font-medium text-gray-800 bg-gray-200 border border-gray-300 rounded-md shadow-sm hover:bg-gray-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400">
                            Batal
                        </button>
                        <button type="submit" form="addDataForm" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-[#4F46E5] hover:bg-[#4338CA] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#4338CA]">
                            Simpan
                        </button>
                    </div>
                </div>
            </div>
        `;
    }

    // Function to load modal for specific category
    function loadModalForCategory(category) {
        const config = modalConfigs[category];
        if (config) {
            console.log('Loading modal for category:', category);
            document.getElementById('modal').innerHTML = generateModalHTML(config);
        } else {
            console.warn('No modal config found for category:', category);
        }
    }

    // Expose function globally for external access
    window.refreshModalForCategory = loadModalForCategory;

    // Wait for the variable to be available
    function waitForCategory() {
        if (typeof window.currentDashboardCategory !== 'undefined') {
            const currentCategory = window.currentDashboardCategory;
            console.log('Detected currentDashboardCategory:', currentCategory);
            loadModalForCategory(currentCategory);
        } else {
            // Check again after a short delay
            setTimeout(waitForCategory, 100);
        }
    }

    // Register callback for category changes (this will be called when sidebar category changes)
    if (typeof window.registerDataChangeCallback === 'function') {
        window.registerDataChangeCallback('modals', function() {
            if (window.currentDashboardCategory) {
                console.log('Modal callback triggered for category:', window.currentDashboardCategory);
                loadModalForCategory(window.currentDashboardCategory);
            }
        });
    } else {
        // If registerDataChangeCallback is not available yet, try again later
        setTimeout(() => {
            if (typeof window.registerDataChangeCallback === 'function') {
                window.registerDataChangeCallback('modals', function() {
                    if (window.currentDashboardCategory) {
                        console.log('Modal callback triggered for category:', window
                            .currentDashboardCategory);
                        loadModalForCategory(window.currentDashboardCategory);
                    }
                });
            }
        }, 200);
    }

    // Start checking when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', waitForCategory);
    } else {
        waitForCategory();
    }

    // Anggota input functions (moved to global scope)
    window.addAnggotaInput = function() {
        const container = document.getElementById('anggotaContainer');
        const newInputGroup = document.createElement('div');
        newInputGroup.className = 'anggota-input-group flex items-center space-x-2 mb-2';

        newInputGroup.innerHTML = `
            <input type="text" name="Anggota[]" placeholder="Nama Anggota" class="flex-1 border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-[#4F46E5] focus:border-[#4F46E5]">
            <button type="button" onclick="removeAnggotaInput(this)" class="px-3 py-2 text-red-600 border border-red-300 rounded-md hover:bg-red-50 focus:outline-none">
                <span class="text-sm material-icons-outlined">remove</span>
            </button>
        `;

        container.appendChild(newInputGroup);
        updateRemoveButtons();
    }

    window.removeAnggotaInput = function(button) {
        const inputGroup = button.parentElement;
        inputGroup.remove();
        updateRemoveButtons();
    }

    function updateRemoveButtons() {
        const inputGroups = document.querySelectorAll('.anggota-input-group');
        inputGroups.forEach((group, index) => {
            const removeButton = group.querySelector('button');
            if (inputGroups.length > 1) {
                removeButton.style.display = 'block';
            } else {
                removeButton.style.display = 'none';
            }
        });
    }

    // Override openModal function to handle anggota inputs
    const originalOpenModal = window.openModal;
    window.openModal = function(modalId) {
        if (originalOpenModal) {
            originalOpenModal(modalId);
        } else {
            document.getElementById(modalId).classList.remove('hidden');
        }

        if (modalId === 'addDataModal') {
            setTimeout(updateRemoveButtons, 100);
        }
    }
</script>