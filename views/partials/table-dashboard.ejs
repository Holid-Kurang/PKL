<div class="overflow-x-auto bg-white rounded-lg shadow-md">
    <div class="overflow-y-auto md:max-h-[640px]">
        <table class="w-full text-sm text-left whitespace-nowrap">
            <thead class="sticky top-0 z-30 text-xs uppercase bg-gray-200">
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Fungsi untuk membuat header tabel
    function createTableHeader(data = []) {
        const tableHead = document.querySelector('thead');

        if (data.length === 0) {
            // Jika tidak ada data, buat header default atau kosong
            tableHead.innerHTML = `
                <tr>
                    <th scope="col" class="px-6 py-3">No</th>
                    <th scope="col" class="px-6 py-3">Data</th>
                    <th scope="col" class="sticky right-0 px-6 py-3 text-center bg-gray-200">Aksi</th>
                </tr>
            `;
            return;
        }

        const firstItem = data[0];
        const headers = Object.keys(firstItem).filter(key => key !== '_id' && key !== '__v');

        let headerRow = '<tr>';
        headerRow += '<th scope="col" class="px-6 py-3">No</th>';

        headers.forEach(header => {
            headerRow += `
                <th scope="col" class="px-6 py-3 transition-colors cursor-pointer hover:bg-gray-300 sortable-header"
                    onclick="sortTable('${header}')">
                    <div class="flex items-center justify-between">
                        <span>${header}</span>
                        <span class="text-sm material-icons-outlined sort-icon" id="sort-${header}">unfold_more</span>
                    </div>
                </th>
            `;
        });

        headerRow += '<th scope="col" class="sticky right-0 px-6 py-3 text-center bg-gray-200">Aksi</th>';
        headerRow += '</tr>';
        tableHead.innerHTML = headerRow;
    }

    // Fungsi untuk membuat body tabel
    function createTableBody(data = []) {
        const tableBody = document.querySelector('tbody');
        if (data.length === 0) {
            tableBody.innerHTML = `
            <tr>
                <td colspan="100%" class="px-6 py-4 text-center text-gray-500">Tidak ada data tersedia</td>
            </tr>
            `;
            return;
        }

        let bodyRows = '';
        data.forEach((item, index) => {
            bodyRows += '<tr class="border-b hover:bg-gray-50">';
            bodyRows += `<td class="px-6 py-4">${index + 1}</td>`;
            Object.keys(item).forEach(key => {
                if (key !== '_id' && key !== '__v') {
                    if (key === 'Judul') {
                        bodyRows +=
                            `<td class="px-6 py-4"><p class="w-96 text-wrap">${item[key]}</p></td>`;
                    } else if (key === 'Anggota') {
                        bodyRows += `<td class="relative px-6 py-4">`;
                        let anggotaArray = [];
                        if (item.Anggota && Array.isArray(item.Anggota)) {
                            anggotaArray = item.Anggota.filter(anggota => anggota && anggota.trim() !==
                                '');
                        }
                        if (anggotaArray.length > 0) {
                            bodyRows += `<div class="flex flex-col space-y-1">`;
                            anggotaArray.forEach(anggota => {
                                bodyRows +=
                                    `<div class="px-2 py-1 text-xs text-blue-800 bg-blue-100 rounded-md">${anggota}</div>`;
                            });
                            bodyRows += `</div>`;
                        } else {
                            bodyRows += `<span class="italic text-gray-400">-</span>`;
                        }
                        bodyRows += `</td>`;
                    } else {
                        bodyRows += `<td class="px-6 py-4">${item[key]}</td>`;
                    }
                }
            });

            // Add action buttons column
            bodyRows += `<td class="sticky right-0 z-10 px-6 py-4 text-center bg-gray-200 whitespace-nowrap">
                            <button 
                                onclick="openEditModal('${JSON.stringify(item).replace(/'/g, '&apos;')}')" 
                                class="px-4 py-1 text-xs font-bold text-white bg-green-500 rounded-lg hover:bg-green-600">
                                Edit
                            </button>
                            <button
                                onclick="openDeleteModal('/dashboard/penelitian/pnbp/delete/${item._id}?_method=DELETE')"
                                class="bg-[#4338CA] hover:bg-[#3730A3] text-white text-xs font-bold py-1 px-4 rounded-lg">
                                Hapus
                            </button>
                        </td>`;
            bodyRows += '</tr>';
        });

        tableBody.innerHTML = bodyRows;
    }

    // Fungsi untuk mengurutkan tabel berdasarkan kolom tertentu
    function sortTable(column) {
        const data = window.dashboardData || [];
        if (data.length === 0) return;

        // Dapatkan ikon sort saat ini
        const currentSortIcon = document.getElementById(`sort-${column}`);
        const currentSortOrder = currentSortIcon.getAttribute('data-order') || 'none';

        // Tentukan urutan baru
        let newSortOrder;
        if (currentSortOrder === 'none' || currentSortOrder === 'desc') {
            newSortOrder = 'asc';
            currentSortIcon.textContent = 'arrow_upward';
        } else {
            newSortOrder = 'desc';
            currentSortIcon.textContent = 'arrow_downward';
        }
        currentSortIcon.setAttribute('data-order', newSortOrder);

        // Reset ikon sort lainnya
        document.querySelectorAll('.sort-icon').forEach(icon => {
            if (icon.id !== `sort-${column}`) {
                icon.textContent = 'unfold_more';
                icon.setAttribute('data-order', 'none');
            }
        });

        // Urutkan data
        data.sort((a, b) => {
            if (a[column] < b[column]) return newSortOrder === 'asc' ? -1 : 1;
            if (a[column] > b[column]) return newSortOrder === 'asc' ? 1 : -1;
            return 0;
        });

        // Perbarui tabel dengan data yang sudah diurutkan
        createTableBody(data);
    }

    // Fungsi untuk memperbarui tabel ketika data berubah
    function updateTable() {
        const data = window.dashboardData || [];
        createTableHeader(data);

        // Cek apakah pagination aktif
        if (typeof window.updatePagination === 'function') {
            // Biarkan pagination yang handle body tabel
            window.updatePagination();
        } else {
            // Jika tidak ada pagination, tampilkan semua data
            createTableBody(data);
        }
    }

    // Jalankan saat halaman dimuat
    document.addEventListener('DOMContentLoaded', function() {
        // Delay sedikit untuk memastikan pagination sudah ready
        setTimeout(() => {
            updateTable();
        }, 100);

        // Daftarkan callback untuk perubahan data
        if (typeof window.registerDataChangeCallback === 'function') {
            window.registerDataChangeCallback('table', updateTable);
        } else {
            // Fallback jika sistem callback belum ada
            setTimeout(() => {
                if (typeof window.registerDataChangeCallback === 'function') {
                    window.registerDataChangeCallback('table', updateTable);
                }
            }, 200);
        }
    });

    // Fungsi untuk dipanggil dari luar jika diperlukan
    window.refreshTable = updateTable;
</script>